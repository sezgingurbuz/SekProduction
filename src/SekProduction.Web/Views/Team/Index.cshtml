@model List<TeamMember>
@{
    ViewData["Title"] = "Ekibimiz";
}

<h1 class="mb-4">Ekibimiz</h1>

@if (!Model.Any())
{
    <p class="text-muted">Ekip bilgisi henüz eklenmedi.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-4 g-4">
        @foreach (var member in Model)
        {
            <div class="col text-center">
                @if (!string.IsNullOrEmpty(member.PhotoUrl))
                {
                    <img src="@member.PhotoUrl" class="rounded-circle mb-2" alt="@member.FullName" style="width:120px;height:120px;object-fit:cover" />
                }
                <h5 class="mb-0">@member.FullName</h5>
                <p class="text-muted">@member.Title</p>
                @if (!string.IsNullOrEmpty(member.Bio))
                {
                    <p class="small">@member.Bio</p>
                }
                @if (!string.IsNullOrEmpty(member.LinkedInUrl))
                {
                    <a href="@member.LinkedInUrl" target="_blank" rel="noopener">LinkedIn</a>
                }
            </div>
        }
    </div>
}
