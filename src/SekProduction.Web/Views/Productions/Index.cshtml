@model List<Production>
@{
    ViewData["Title"] = "Yapımlar";
    var selectedCategory = ViewData["SelectedCategory"] as ProductionCategory?;
}

<h1 class="mb-4">Yapımlarımız</h1>

<div class="mb-4 d-flex flex-wrap gap-2">
    <a asp-action="Index" class="btn btn-sm @(selectedCategory is null ? "btn-dark" : "btn-outline-dark")">Tümü</a>
    @foreach (var category in Enum.GetValues<ProductionCategory>())
    {
        <a asp-action="Index" asp-route-category="@category" class="btn btn-sm @(selectedCategory == category ? "btn-dark" : "btn-outline-dark")">
            @category.GetDisplayName()
        </a>
    }
</div>

@if (!Model.Any())
{
    <p class="text-muted">Bu kategoride henüz yapım bulunmuyor.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var production in Model)
        {
            <div class="col">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(production.CoverImageUrl))
                    {
                        <img src="@production.CoverImageUrl" class="card-img-top" alt="@production.Title" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@production.Title</h5>
                        <p class="card-text">@production.ShortDescription</p>
                        @{
                            var nextDate = production.EventSchedules
                                .Where(e => e.EventDate >= DateTime.UtcNow.Date)
                                .OrderBy(e => e.EventDate)
                                .FirstOrDefault();
                        }
                        @if (nextDate is not null)
                        {
                            <p class="text-muted small mb-0">@nextDate.EventDate.ToString("dd MMMM yyyy")@(nextDate.City is null ? "" : $" · {nextDate.City}")</p>
                        }
                        else if (production.Year is not null)
                        {
                            <p class="text-muted small mb-0">@production.Year</p>
                        }
                    </div>
                    <div class="card-footer">
                        <a asp-action="Details" asp-route-slug="@production.Slug" class="btn btn-sm btn-outline-dark">Detaylar</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
