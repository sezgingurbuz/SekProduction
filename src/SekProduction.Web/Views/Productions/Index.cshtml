@model List<Production>
@{
    ViewData["Title"] = "Yapımlar";

    var today = DateTime.Now.Date;
    var groups = new[]
    {
        (Category: ProductionCategory.ChaplinSanat, Anchor: "chaplin-sanat", Empty: "Yeni yetişkin oyunlarımız yakında duyurulacak."),
        (Category: ProductionCategory.ChaplinCocukSanat, Anchor: "chaplin-cocuk-sanat", Empty: "Yeni çocuk oyunlarımız yakında duyurulacak."),
        (Category: ProductionCategory.SekProduction, Anchor: "sek-production", Empty: "Yeni konser ve etkinliklerimiz yakında duyurulacak.")
    };
}

<h1 class="mb-3">Yapımlarımız</h1>

<nav class="productions-nav mb-5" aria-label="Yapım başlıkları">
    @foreach (var group in groups)
    {
        <a href="#@group.Anchor" class="btn btn-outline-dark">@group.Category.GetDisplayName()</a>
    }
</nav>

@foreach (var group in groups)
{
    var items = Model.Where(p => p.Category == group.Category).ToList();

    <section class="productions-section" id="@group.Anchor">
        <header class="productions-section__header">
            <h2>@group.Category.GetDisplayName()</h2>
            <p class="text-muted mb-0">@group.Category.GetDescription()</p>
        </header>

        @if (!items.Any())
        {
            <p class="text-muted">@group.Empty</p>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
                @foreach (var production in items)
                {
                    var nextDate = production.EventSchedules
                        .Where(e => e.EventDate >= today)
                        .OrderBy(e => e.EventDate)
                        .FirstOrDefault();
                    <div class="col">
                        <a asp-action="Details" asp-route-slug="@production.Slug" class="production-card card h-100 text-decoration-none text-reset">
                            <div class="production-card__poster">
                                @if (!string.IsNullOrEmpty(production.CoverImageUrl))
                                {
                                    <img src="@production.CoverImageUrl" alt="@production.Title" loading="lazy" />
                                }
                                else
                                {
                                    <span>@production.Title</span>
                                }
                            </div>
                            <div class="card-body">
                                <h3 class="h5 card-title">@production.Title</h3>
                                @if (!string.IsNullOrEmpty(production.ShortDescription))
                                {
                                    <p class="card-text small">@production.ShortDescription</p>
                                }
                                @if (nextDate is not null)
                                {
                                    <p class="text-muted small mb-0">@nextDate.EventDate.ToString("dd MMMM yyyy")@(nextDate.City is null ? "" : $" · {nextDate.City}")</p>
                                }
                                else if (production.Year is not null)
                                {
                                    <p class="text-muted small mb-0">@production.Year</p>
                                }
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </section>
}
