@model EventDetailsViewModel
@{
    var item = Model.Event;
    var production = item.Production;
    var isAdmin = User.IsInRole(AppRoles.Admin);
    ViewData["Title"] = $"{production?.Title} · {item.EventDate:d MMMM yyyy}";
}

<div class="page-header">
    <div>
        <a asp-controller="Calendar" asp-action="Index" asp-route-year="@item.EventDate.Year" asp-route-month="@item.EventDate.Month"
           class="text-decoration-none small">&larr; Takvim</a>
        <h1><span class="event-dot" style="--c: @Model.Color"></span>@production?.Title</h1>
        <div class="text-muted">
            @item.EventDate.ToString("d MMMM yyyy, dddd · HH:mm") &middot; @item.City@(string.IsNullOrWhiteSpace(item.Venue) ? "" : " · " + item.Venue)
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (!string.IsNullOrWhiteSpace(item.TicketUrl))
        {
            <a href="@item.TicketUrl" target="_blank" rel="noopener" class="btn btn-outline-dark">Bilet Sayfası ↗</a>
        }
        @if (isAdmin)
        {
            <a asp-area="Admin" asp-controller="EventSchedules" asp-action="Index"
               asp-route-productionId="@item.ProductionId" asp-route-year="@item.EventDate.Year" asp-route-month="@item.EventDate.Month"
               class="btn btn-warning">Etkinliği Düzenle</a>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h6 text-uppercase text-muted">Etkinlik</h2>
                <dl class="detail-grid row mb-0">
                    <dt class="col-sm-4">Tarih ve saat</dt>
                    <dd class="col-sm-8">@item.EventDate.ToString("d MMMM yyyy, dddd · HH:mm")</dd>

                    <dt class="col-sm-4">Şehir</dt>
                    <dd class="col-sm-8">@item.City</dd>

                    <dt class="col-sm-4">Salon</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(item.Venue) ? "—" : item.Venue)</dd>

                    <dt class="col-sm-4">Menü</dt>
                    <dd class="col-sm-8">@(production?.Category.GetDisplayName() ?? "—")</dd>

                    @if (production?.DurationMinutes is not null || production?.ActCount is not null)
                    {
                        <dt class="col-sm-4">Süre</dt>
                        <dd class="col-sm-8">
                            @(production.DurationText ?? "—")
                            @if (production.ActCount is not null)
                            {
                                <span class="text-muted">· @production.ActCount perde</span>
                            }
                        </dd>
                    }

                    @if (!string.IsNullOrWhiteSpace(production?.AgeLimit))
                    {
                        <dt class="col-sm-4">Yaş sınırı</dt>
                        <dd class="col-sm-8">@production.AgeLimit</dd>
                    }
                </dl>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h6 text-uppercase text-muted">Ekip Notları</h2>
                <div class="text-muted small mb-2">Yöneticilerin bütün ekibe bıraktığı notlar.</div>

                @if (!Model.TeamNotes.Any())
                {
                    <div class="text-muted small">Bu etkinlik için ekip notu yok.</div>
                }
                else
                {
                    @foreach (var note in Model.TeamNotes)
                    {
                        <div class="note note--team">
                            <div class="note__body">@note.Body</div>
                            <div class="note__meta">
                                <span>@note.AuthorName &middot; @note.CreatedAt.ToLocalTime().ToString("d MMMM yyyy HH:mm")</span>
                                @if (note.UpdatedAt is not null)
                                {
                                    <span>(düzenlendi)</span>
                                }
                                @if (isAdmin)
                                {
                                    <form asp-controller="EventNotes" asp-action="Delete" asp-route-id="@note.Id" method="post"
                                          data-confirm="Bu ekip notu silinsin mi?">
                                        <button type="submit" class="btn btn-link btn-sm p-0 text-danger align-baseline">Sil</button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                }

                @if (isAdmin)
                {
                    <form asp-controller="EventNotes" asp-action="Create" method="post" class="mt-3">
                        <input type="hidden" name="eventScheduleId" value="@item.Id" />
                        <input type="hidden" name="scope" value="@EventNoteScope.Team" />
                        <label class="form-label small" for="team-note">Ekibe not bırak</label>
                        <textarea id="team-note" name="body" class="form-control" rows="3" maxlength="2000"
                                  placeholder="Buluşma saati, ulaşım, teknik istekler..."></textarea>
                        <button type="submit" class="btn btn-sm btn-primary mt-2">Ekip Notu Ekle</button>
                    </form>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h6 text-uppercase text-muted">Kendi Notlarım</h2>
                <div class="text-muted small mb-2">Bu notları yalnızca siz görürsünüz.</div>

                @if (!Model.MyNotes.Any())
                {
                    <div class="text-muted small">Henüz kendinize not almadınız.</div>
                }
                else
                {
                    @foreach (var note in Model.MyNotes)
                    {
                        <div class="note note--private">
                            <form asp-controller="EventNotes" asp-action="Update" asp-route-id="@note.Id" method="post">
                                <textarea name="body" class="form-control form-control-sm" rows="2" maxlength="2000">@note.Body</textarea>
                                <div class="note__meta">
                                    <span>@note.CreatedAt.ToLocalTime().ToString("d MMMM yyyy HH:mm")</span>
                                    @if (note.UpdatedAt is not null)
                                    {
                                        <span>(düzenlendi)</span>
                                    }
                                    <button type="submit" class="btn btn-link btn-sm p-0 align-baseline">Kaydet</button>
                                </div>
                            </form>
                            <form asp-controller="EventNotes" asp-action="Delete" asp-route-id="@note.Id" method="post"
                                  data-confirm="Bu notunuz silinsin mi?">
                                <button type="submit" class="btn btn-link btn-sm p-0 text-danger align-baseline">Sil</button>
                            </form>
                        </div>
                    }
                }

                <form asp-controller="EventNotes" asp-action="Create" method="post" class="mt-3">
                    <input type="hidden" name="eventScheduleId" value="@item.Id" />
                    <input type="hidden" name="scope" value="@EventNoteScope.Private" />
                    <label class="form-label small" for="private-note">Yeni kişisel not</label>
                    <textarea id="private-note" name="body" class="form-control" rows="3" maxlength="2000"
                              placeholder="Otel rezervasyonum, fiş/fatura, kişisel hatırlatma..."></textarea>
                    <button type="submit" class="btn btn-sm btn-outline-dark mt-2">Not Ekle</button>
                </form>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(production?.Credits))
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h6 text-uppercase text-muted">Künye</h2>
                    <div style="white-space: pre-line">@production.Credits</div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <h2 class="h6 text-uppercase text-muted">@item.City otelleri</h2>
                    <a asp-controller="Hotels" asp-action="Index" asp-route-city="@item.City" class="small">Tümü</a>
                </div>
                @if (!Model.Hotels.Any())
                {
                    <div class="text-muted small">Bu şehir için kayıtlı otel yok.</div>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var hotel in Model.Hotels)
                        {
                            <li class="border-bottom py-2">
                                <div class="fw-semibold">
                                    @hotel.Name
                                    @if (hotel.IsPreferred)
                                    {
                                        <span class="badge bg-success">Anlaşmalı</span>
                                    }
                                </div>
                                <div class="small">
                                    Tek: @(hotel.SingleRoomPrice is null ? "—" : hotel.SingleRoomPrice.Value.ToString("C2"))
                                    &middot;
                                    Çift: @(hotel.DoubleRoomPrice is null ? "—" : hotel.DoubleRoomPrice.Value.ToString("C2"))
                                    <span class="text-muted">· kahvaltı @(hotel.BreakfastIncluded ? "dahil" : "hariç")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(hotel.Phone))
                                {
                                    <div class="small text-muted">@hotel.Phone</div>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        @if (production?.CastMembers.Any() == true)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h6 text-uppercase text-muted">Oyuncular</h2>
                    <ul class="list-unstyled mb-0">
                        @foreach (var cast in production.CastMembers.OrderBy(c => c.DisplayOrder).ThenBy(c => c.FullName))
                        {
                            <li class="mb-1">
                                <strong>@cast.FullName</strong>
                                @if (!string.IsNullOrWhiteSpace(cast.RoleName))
                                {
                                    <span class="text-muted">· @cast.RoleName</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (Model.SameDayEvents.Any())
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h6 text-uppercase text-muted">Aynı gün diğer etkinlikler</h2>
                    @foreach (var other in Model.SameDayEvents)
                    {
                        <a class="d-block text-decoration-none event-row px-0" style="--c: @Model.ColorFor(other.ProductionId)"
                           asp-action="Details" asp-route-id="@other.Id">
                            <span class="event-row__date">@other.EventDate.ToString("HH:mm")</span>
                            <strong>@other.Production?.Title</strong>
                            <span class="text-muted">@other.City</span>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>
