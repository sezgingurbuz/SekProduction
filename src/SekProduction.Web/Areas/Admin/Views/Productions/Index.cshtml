@model IEnumerable<SekProduction.Web.Models.Production>

@{
    ViewData["Title"] = "Yapımlar";
    var today = DateTime.UtcNow.Date;
    var selectedCategory = ViewData["SelectedCategory"] as ProductionCategory?;
    var counts = (Dictionary<ProductionCategory, int>)ViewData["CategoryCounts"]!;
}

<div class="admin-page-header">
    <div>
        <h1>Yapımlar</h1>
        <div class="text-muted small">
            @if (selectedCategory is null)
            {
                <text>Toplam @Model.Count() yapım</text>
            }
            else
            {
                <text>@selectedCategory.Value.GetDisplayName() menüsünde @Model.Count() yapım</text>
            }
        </div>
    </div>
    @if (selectedCategory is not null)
    {
        <a asp-action="Create" asp-route-category="@selectedCategory" class="btn btn-primary">+ @selectedCategory.Value.GetDisplayName() Yapımı Ekle</a>
    }
    else
    {
        <div class="dropdown">
            <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">+ Yeni Yapım</button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><h6 class="dropdown-header">Hangi menüye eklenecek?</h6></li>
                @foreach (var category in Enum.GetValues<ProductionCategory>())
                {
                    <li><a class="dropdown-item" asp-action="Create" asp-route-category="@category">@category.GetDisplayName()</a></li>
                }
            </ul>
        </div>
    }
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link @(selectedCategory is null ? "active" : "")" asp-area="Admin" asp-action="Index">
            Tümü <span class="badge rounded-pill bg-light text-dark border ms-1">@counts.Values.Sum()</span>
        </a>
    </li>
    @foreach (var category in Enum.GetValues<ProductionCategory>())
    {
        <li class="nav-item">
            <a class="nav-link @(selectedCategory == category ? "active" : "")" asp-area="Admin" asp-action="Index" asp-route-category="@category">
                @category.GetDisplayName() <span class="badge rounded-pill bg-light text-dark border ms-1">@counts.GetValueOrDefault(category)</span>
            </a>
        </li>
    }
</ul>

<div class="admin-card">
    @if (!Model.Any())
    {
        <div class="admin-empty">
            @if (selectedCategory is null)
            {
                <p class="mb-3">Henüz hiç yapım eklenmedi.</p>
                <a asp-action="Create" class="btn btn-outline-primary">İlk yapımı ekle</a>
            }
            else
            {
                <p class="mb-3">@selectedCategory.Value.GetDisplayName() menüsünde henüz yapım yok.</p>
                <a asp-action="Create" asp-route-category="@selectedCategory" class="btn btn-outline-primary">İlk yapımı ekle</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th style="width: 88px;"></th>
                        <th>Yapım</th>
                        <th>Menü</th>
                        <th>Yakın Etkinlik</th>
                        <th>Durum</th>
                        <th class="text-center">Sıra</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var upcoming = item.EventSchedules.Where(e => e.EventDate >= today).OrderBy(e => e.EventDate).ToList();
                        var next = upcoming.FirstOrDefault();
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                                {
                                    <img src="@item.CoverImageUrl" alt="@item.Title" class="admin-thumb" />
                                }
                                else
                                {
                                    <div class="admin-thumb">Görsel yok</div>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="fw-semibold text-decoration-none text-dark">@item.Title</a>
                                <div class="text-muted small">/Yapimlar/@item.Slug</div>
                            </td>
                            <td>
                                <span class="badge rounded-pill bg-light text-dark border">@item.Category.GetDisplayName()</span>
                                @if (item.Year is not null)
                                {
                                    <div class="text-muted small mt-1">@item.Year</div>
                                }
                            </td>
                            <td>
                                @if (next is not null)
                                {
                                    <div>@next.EventDate.ToString("dd MMM yyyy, HH:mm")</div>
                                    <div class="text-muted small">
                                        @next.City
                                        @if (upcoming.Count > 1)
                                        {
                                            <text>· +@(upcoming.Count - 1) tarih daha</text>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">Planlanmış tarih yok</span>
                                }
                            </td>
                            <td>
                                @if (item.IsPublished)
                                {
                                    <span class="badge bg-success">Yayında</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Taslak</span>
                                }
                                @if (item.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark">Öne Çıkan</span>
                                }
                            </td>
                            <td class="text-center">@item.DisplayOrder</td>
                            <td class="text-end text-nowrap">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                    <button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                                        <span class="visually-hidden">Diğer işlemler</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="EventSchedules" asp-action="Index" asp-route-productionId="@item.Id">Etkinlik Günleri (@item.EventSchedules.Count)</a></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="CastMembers" asp-action="Index" asp-route-productionId="@item.Id">Oyuncular (@item.CastMembers.Count)</a></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="ProductionPhotos" asp-action="Index" asp-route-productionId="@item.Id">Galeri (@item.Photos.Count)</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id">Sil</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
