@model SekProduction.Web.Models.Production

@{
    ViewData["Title"] = "Yapımı Düzenle";
}

<div class="admin-page-header">
    <div>
        <a asp-area="Admin" asp-action="Index" class="text-decoration-none small">&larr; Yapımlar</a>
        <h1>@Model.Title</h1>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-area="Admin" asp-controller="EventSchedules" asp-action="Index" asp-route-productionId="@Model.Id" class="btn btn-outline-dark">Etkinlik Günleri</a>
        <a asp-area="Admin" asp-controller="CastMembers" asp-action="Index" asp-route-productionId="@Model.Id" class="btn btn-outline-dark">Oyuncular</a>
        <a asp-area="Admin" asp-controller="ProductionPhotos" asp-action="Index" asp-route-productionId="@Model.Id" class="btn btn-outline-dark">Galeri</a>
        @if (Model.IsPublished)
        {
            <a asp-area="" asp-controller="Productions" asp-action="Details" asp-route-slug="@Model.Slug" target="_blank" class="btn btn-outline-secondary">Sitede Gör ↗</a>
        }
    </div>
</div>

<form asp-action="Edit" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <partial name="_ProductionForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin-production-form.js" asp-append-version="true"></script>
}
