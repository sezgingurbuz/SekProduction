@model SekProduction.Web.Models.Production

@{
    ViewData["Title"] = "Yapımı Sil";
}

<div class="admin-page-header">
    <div>
        <a asp-area="Admin" asp-action="Index" class="text-decoration-none small">&larr; Yapımlar</a>
        <h1>Yapımı Sil</h1>
    </div>
</div>

<div class="admin-card p-4" style="max-width: 640px;">
    <div class="d-flex gap-3 align-items-center mb-4">
        @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
        {
            <img src="@Model.CoverImageUrl" alt="@Model.Title" class="admin-thumb" style="width: 120px; height: 80px;" />
        }
        <div>
            <div class="fw-semibold fs-5">@Model.Title</div>
            <div class="text-muted small">@Model.Category.GetDisplayName() · /Yapimlar/@Model.Slug</div>
        </div>
    </div>

    <div class="alert alert-danger mb-4">
        Bu yapım kalıcı olarak silinecek.
        @if (Model.EventSchedules.Any())
        {
            <text>Bağlı <strong>@Model.EventSchedules.Count etkinlik tarihi</strong> de silinecek.</text>
        }
        @if (Model.CastMembers.Any() || Model.Photos.Any())
        {
            <text>@Model.CastMembers.Count oyuncu kaydı ve @Model.Photos.Count galeri fotoğrafı da silinecek.</text>
        }
        @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
        {
            <text>Yüklenen kapak görseli de kaldırılacak.</text>
        }
        Bu işlem geri alınamaz.
    </div>

    <form asp-action="Delete" class="d-flex gap-2">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Evet, sil</button>
        <a asp-area="Admin" asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
    </form>
</div>
