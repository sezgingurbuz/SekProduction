@model TourCalendarViewModel
@{
    var production = Model.FixedProduction!;
    ViewData["Title"] = $"Etkinlik Günleri · {production.Title}";
    ViewData["ContainerClass"] = "container-fluid admin-wide";
}

<div class="admin-page-header">
    <div class="d-flex align-items-center gap-3">
        @if (!string.IsNullOrEmpty(production.CoverImageUrl))
        {
            <img src="@production.CoverImageUrl" alt="@production.Title" class="admin-thumb" />
        }
        <div>
            <a asp-area="Admin" asp-controller="Productions" asp-action="Index" asp-route-category="@production.Category" class="text-decoration-none small">&larr; Yapımlar</a>
            <h1>
                <span class="tour-dot" style="--c: @Model.ColorFor(production.Id)"></span>@production.Title
                <span class="badge rounded-pill bg-light text-dark border align-middle fs-6 fw-normal">@production.Category.GetDisplayName()</span>
            </h1>
            <div class="text-muted small">
                Etkinlik günleri: takvimde günlere tıklayarak seçin (Shift ile aralık seçebilirsiniz), alttaki çubuktan ekleyin.
                Ardından şehir, salon ve saat için seansa tıklayın.
            </div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-area="Admin" asp-controller="Productions" asp-action="Edit" asp-route-id="@production.Id" class="btn btn-outline-dark">Yapımı Düzenle</a>
        <a asp-area="Admin" asp-controller="CastMembers" asp-action="Index" asp-route-productionId="@production.Id" class="btn btn-outline-dark">Oyuncular</a>
        <a asp-area="Admin" asp-controller="ProductionPhotos" asp-action="Index" asp-route-productionId="@production.Id" class="btn btn-outline-dark">Galeri</a>
        <a asp-area="Admin" asp-controller="Tour" asp-action="Index" class="btn btn-outline-secondary">Turne Takvimi</a>
    </div>
</div>

<partial name="_TourBoard" model="Model" />

@section Scripts {
    <script src="~/js/admin-tour.js" asp-append-version="true"></script>
}
