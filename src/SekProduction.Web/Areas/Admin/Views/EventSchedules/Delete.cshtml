@model SekProduction.Web.Models.EventSchedule
@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Bu etkinlik tarihini silmek istediğinize emin misiniz?</h3>
<div>
    <h4>@Model.Production?.Title</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.EventDate)</dt>
        <dd class="col-sm-10">@Model.EventDate.ToString("dd.MM.yyyy HH:mm")</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Venue)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Venue)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.City)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.City)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.TicketUrl)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.TicketUrl)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" asp-route-productionId="@Model.ProductionId">Back to List</a>
    </form>
</div>
