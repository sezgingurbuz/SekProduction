@model AnnouncementDetailsViewModel
@{
    var announcement = Model.Announcement;
    ViewData["Title"] = $"Duyuru · {announcement.Title}";
}

<div class="admin-page-header">
    <div>
        <a asp-action="Index" class="text-decoration-none small">&larr; Duyurular</a>
        <h1>
            @announcement.Title
            @if (announcement.IsPinned)
            {
                <span class="badge bg-danger align-middle fs-6">Önemli</span>
            }
        </h1>
        <div class="text-muted small">
            @announcement.AuthorName &middot; @announcement.CreatedAt.ToLocalTime().ToString("d MMMM yyyy HH:mm")
            @if (announcement.UpdatedAt is not null)
            {
                <span>&middot; düzenlendi @announcement.UpdatedAt.Value.ToLocalTime().ToString("d MMMM yyyy HH:mm")</span>
            }
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@announcement.Id" class="btn btn-outline-dark">Düzenle</a>
        <form asp-action="Delete" asp-route-id="@announcement.Id" method="post" data-confirm="Bu duyuru silinsin mi?">
            <button type="submit" class="btn btn-outline-danger">Sil</button>
        </form>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <div style="white-space: pre-line">@announcement.Body</div>
                @if (announcement.EventSchedule is not null)
                {
                    <hr />
                    <div class="small text-muted">
                        İlgili etkinlik:
                        <a asp-area="" asp-controller="Events" asp-action="Details" asp-route-id="@announcement.EventSchedule.Id">
                            @announcement.EventSchedule.Production?.Title ·
                            @announcement.EventSchedule.EventDate.ToString("d MMMM yyyy HH:mm") ·
                            @announcement.EventSchedule.City
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <h2 class="h6 text-uppercase text-muted">
                    Okuma durumu
                    <span class="text-dark">@Model.ReadBy.Count / @Model.Recipients.Count</span>
                </h2>

                @if (Model.NotReadBy.Any())
                {
                    <div class="fw-semibold small mt-2">Okumayanlar</div>
                    <ul class="list-unstyled small mb-2">
                        @foreach (var row in Model.NotReadBy)
                        {
                            <li>@(row.User?.DisplayName ?? "(silinmiş hesap)")</li>
                        }
                    </ul>
                }

                @if (Model.ReadBy.Any())
                {
                    <div class="fw-semibold small mt-2">Okuyanlar</div>
                    <ul class="list-unstyled small mb-0">
                        @foreach (var row in Model.ReadBy)
                        {
                            <li>
                                @(row.User?.DisplayName ?? "(silinmiş hesap)")
                                <span class="text-muted">· @row.ReadAt!.Value.ToLocalTime().ToString("d MMM HH:mm")</span>
                            </li>
                        }
                    </ul>
                }

                @if (!Model.Recipients.Any())
                {
                    <div class="text-muted small">Bu duyurunun alıcısı yok.</div>
                }
            </div>
        </div>
    </div>
</div>
