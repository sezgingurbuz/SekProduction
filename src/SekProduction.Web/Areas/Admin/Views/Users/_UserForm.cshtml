@model UserFormViewModel

<div asp-validation-summary="All" class="text-danger mb-3"></div>
<input type="hidden" asp-for="Id" />

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" autocomplete="off" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="JobTitle" class="form-label"></label>
        <input asp-for="JobTitle" class="form-control" list="job-titles" autocomplete="off" placeholder="Örn. Turne Sorumlusu" />
        <datalist id="job-titles">
            <option value="Turne Sorumlusu"></option>
            <option value="Sahne Amiri"></option>
            <option value="Teknik Ekip"></option>
            <option value="Oyuncu"></option>
            <option value="Ofis"></option>
        </datalist>
        <span asp-validation-for="JobTitle" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="off" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Role" class="form-label"></label>
        <select asp-for="Role" class="form-select">
            @foreach (var role in AppRoles.All)
            {
                <option value="@role">@AppRoles.DisplayName(role)</option>
            }
        </select>
        <div class="form-text">Yöneticiler bütün etkinlikleri görür, duyuru gönderir ve kullanıcı açar.</div>
        <span asp-validation-for="Role" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        @if (!Model.IsNew)
        {
            <div class="form-text">Değiştirmek istemiyorsanız boş bırakın.</div>
        }
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    <div class="col-12">
        <div class="form-check">
            <input class="form-check-input" asp-for="IsActive" />
            <label class="form-check-label" asp-for="IsActive"></label>
            <div class="form-text">Pasif hesaplar portala giriş yapamaz.</div>
        </div>
        <span asp-validation-for="IsActive" class="text-danger"></span>
    </div>

    <div class="col-12">
        <hr />
        <label class="form-label">@Html.DisplayNameFor(m => m.ProductionIds)</label>
        <div class="form-text mb-2">
            Seçtiğiniz yapımların etkinlik tarihleri çalışanın takvimine ve panelinde görünür.
            Hiçbirini seçmezseniz çalışan bütün etkinlikleri görür.
        </div>

        @if (!Model.Productions.Any())
        {
            <div class="text-muted small">Kayıtlı yapım yok.</div>
        }
        else
        {
            @foreach (var group in Model.Productions.GroupBy(p => p.Category))
            {
                <div class="mb-2">
                    <div class="fw-semibold small text-muted">@group.Key.GetDisplayName()</div>
                    <div class="row g-2">
                        @foreach (var production in group)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="ProductionIds" value="@production.Id"
                                           id="production-@production.Id" checked="@Model.ProductionIds.Contains(production.Id)" />
                                    <label class="form-check-label" for="production-@production.Id">@production.Title</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        <span asp-validation-for="ProductionIds" class="text-danger"></span>
    </div>
</div>
