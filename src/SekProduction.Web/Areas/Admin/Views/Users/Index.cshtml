@model List<UserListItemViewModel>
@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="admin-page-header">
    <div>
        <h1>Kullanıcılar</h1>
        <div class="text-muted small">
            Portala giriş yapabilecek çalışanlar burada tanımlanır. Kendi kendine kayıt kapalıdır.
        </div>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Kullanıcı</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Henüz kullanıcı yok.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Ad Soyad</th>
                <th>Görev</th>
                <th>E-posta</th>
                <th>Yetki</th>
                <th>Durum</th>
                <th class="text-end"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td class="fw-semibold">@user.FullName</td>
                    <td class="text-muted">@(string.IsNullOrWhiteSpace(user.JobTitle) ? "—" : user.JobTitle)</td>
                    <td class="text-muted">@user.Email</td>
                    <td>
                        <span class="badge rounded-pill @(user.Role == AppRoles.Admin ? "bg-dark" : "bg-secondary")">@user.RoleDisplayName</span>
                    </td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="text-success">Aktif</span>
                        }
                        else
                        {
                            <span class="text-danger">Pasif</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-dark">Düzenle</a>
                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Bu kullanıcı hesabı silinsin mi?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
