<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yönetim Paneli</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Sek Production &middot; Yönetim Paneli</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-light" asp-area="Admin" asp-controller="Productions" asp-action="Index">Yapımlar</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-area="Admin" asp-controller="TeamMembers" asp-action="Index">Ekip</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-area="Admin" asp-controller="NewsPosts" asp-action="Index">Haberler</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-area="Admin" asp-controller="ClientReferences" asp-action="Index">Referanslar</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-area="Admin" asp-controller="ContactMessages" asp-action="Index">İletişim Mesajları</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index" target="_blank">Siteyi Görüntüle ↗</a></li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container mt-4">
        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="alert alert-info">@statusMessage</div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
