@model TeamMemberFormViewModel
@{
    ViewData["Title"] = "Yeni Ekip Üyesi";
}

<div class="admin-page-header">
    <div>
        <a asp-action="Index" class="text-decoration-none small">&larr; Ekip</a>
        <h1>Yeni Ekip Üyesi</h1>
    </div>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="col-lg-9">
    <partial name="_TeamMemberForm" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
