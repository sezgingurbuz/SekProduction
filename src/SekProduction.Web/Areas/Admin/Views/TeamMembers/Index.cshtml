@model List<TeamMember>
@{
    ViewData["Title"] = "Ekip";
}

<div class="admin-page-header">
    <div>
        <h1>Ekip</h1>
        <div class="text-muted small">
            Oyuncu, teknik ekip ve ofis kayıtları. Kimlik fotokopileri yalnızca yöneticilere görünür.
        </div>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Üye</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Henüz ekip üyesi eklenmedi.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Ad Soyad</th>
                <th>Pozisyon</th>
                <th>E-posta</th>
                <th>Telefon</th>
                <th>Kimlik Fotokopisi</th>
                <th class="text-end"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in Model)
            {
                <tr>
                    <td class="fw-semibold">@member.FullName</td>
                    <td>@member.Title</td>
                    <td class="text-muted">
                        @if (string.IsNullOrWhiteSpace(member.Email))
                        {
                            <span>—</span>
                        }
                        else
                        {
                            <a href="mailto:@member.Email">@member.Email</a>
                        }
                    </td>
                    <td class="text-muted">
                        @if (string.IsNullOrWhiteSpace(member.PhoneNumber))
                        {
                            <span>—</span>
                        }
                        else
                        {
                            <a href="tel:@member.PhoneNumber">@member.PhoneNumber</a>
                        }
                    </td>
                    <td>
                        @if (member.HasIdDocument)
                        {
                            <a asp-action="Document" asp-route-id="@member.Id" target="_blank" rel="noopener">Görüntüle ↗</a>
                            <div class="text-muted small">@member.IdDocumentUploadedAt!.Value.ToLocalTime().ToString("d MMM yyyy")</div>
                        }
                        else
                        {
                            <span class="text-warning">Yok</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@member.Id" class="btn btn-sm btn-outline-dark">Düzenle</a>
                        <form asp-action="Delete" asp-route-id="@member.Id" method="post" class="d-inline"
                              data-confirm="Bu ekip üyesi ve kimlik fotokopisi silinsin mi?">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
