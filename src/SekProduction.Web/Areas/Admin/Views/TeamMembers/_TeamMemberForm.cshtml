@model TeamMemberFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input type="hidden" asp-for="Id" />

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" autocomplete="off" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" list="team-titles" autocomplete="off" placeholder="Örn. Oyuncu" />
        <datalist id="team-titles">
            <option value="Oyuncu"></option>
            <option value="Yönetmen"></option>
            <option value="Sahne Amiri"></option>
            <option value="Işık Teknikeri"></option>
            <option value="Ses Teknikeri"></option>
            <option value="Turne Sorumlusu"></option>
            <option value="Ofis"></option>
        </datalist>
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="off" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" inputmode="tel" autocomplete="off" placeholder="05xx xxx xx xx" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="col-12">
        <hr />
        <label asp-for="IdDocument" class="form-label"></label>

        @if (Model.HasIdDocument)
        {
            <div class="alert alert-light border d-flex flex-wrap gap-3 align-items-center py-2">
                <a asp-action="Document" asp-route-id="@Model.Id" target="_blank" rel="noopener">
                    @(string.IsNullOrWhiteSpace(Model.IdDocumentOriginalName) ? "Yüklü dosyayı görüntüle" : Model.IdDocumentOriginalName) ↗
                </a>
                @if (Model.IdDocumentUploadedAt is not null)
                {
                    <span class="text-muted small">@Model.IdDocumentUploadedAt.Value.ToLocalTime().ToString("d MMMM yyyy HH:mm") tarihinde yüklendi</span>
                }
                <div class="form-check ms-auto">
                    <input class="form-check-input" asp-for="RemoveIdDocument" />
                    <label class="form-check-label" asp-for="RemoveIdDocument"></label>
                </div>
            </div>
        }

        <input asp-for="IdDocument" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,.pdf" />
        <div class="form-text">
            JPG, PNG, WEBP veya PDF; en fazla 10 MB.
            @if (Model.HasIdDocument)
            {
                <span>Yeni dosya seçerseniz mevcut dosya silinir.</span>
            }
            Dosya siteye açık bir adrese konmaz; yalnızca yöneticiler görüntüleyebilir.
        </div>
        <span asp-validation-for="IdDocument" class="text-danger"></span>
    </div>
</div>
