@model TeamMemberFormViewModel
@{
    ViewData["Title"] = $"Ekip · {Model.FullName}";
}

<div class="admin-page-header">
    <div>
        <a asp-action="Index" class="text-decoration-none small">&larr; Ekip</a>
        <h1>@Model.FullName</h1>
        <div class="text-muted small">@Model.Title</div>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="col-lg-9">
    <partial name="_TeamMemberForm" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
