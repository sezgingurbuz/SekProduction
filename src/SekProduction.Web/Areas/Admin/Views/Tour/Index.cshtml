@model TourCalendarViewModel
@{
    ViewData["Title"] = "Turne Takvimi";
    ViewData["ContainerClass"] = "container-fluid admin-wide";
}

<div class="admin-page-header">
    <div>
        <h1>Turne Takvimi</h1>
        <div class="text-muted small">
            Günleri seçmek için takvimde güne tıklayın (Shift ile aralık seçebilirsiniz) ve alttaki çubuktan ekleyin.
            Şehir, salon ve saat için seansa tıklayın; başka güne taşımak için sürükleyin.
            Seçili günlerdeki seansları aynı çubuktan toplu silebilirsiniz.
        </div>
    </div>
    <button type="button" class="btn btn-primary" data-tour-add>+ Seans Ekle</button>
</div>

<partial name="_TourBoard" model="Model" />

@section Scripts {
    <script src="~/js/admin-tour.js" asp-append-version="true"></script>
    <script src="~/js/admin-tour-map.js" asp-append-version="true"></script>
}
