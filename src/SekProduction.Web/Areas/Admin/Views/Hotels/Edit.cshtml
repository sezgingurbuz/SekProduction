@model Hotel
@{
    ViewData["Title"] = $"Otel · {Model.Name}";
}

<div class="admin-page-header">
    <div>
        <a asp-action="Index" asp-route-city="@Model.City" class="text-decoration-none small">&larr; Oteller</a>
        <h1>@Model.Name</h1>
        <div class="text-muted small">@Model.City</div>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-lg-10">
    <partial name="_HotelForm" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Index" asp-route-city="@Model.City" class="btn btn-outline-secondary">Vazgeç</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
